<?xml version="1.0" encoding="utf-8"?><!--
   Health data (workout/weight database and settings datastore) is excluded from
   system cloud backup; other app data (e.g. UI preferences) is still backed up.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="kenko_database" />
    <exclude domain="database" path="kenko_database-shm" />
    <exclude domain="database" path="kenko_database-wal" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
